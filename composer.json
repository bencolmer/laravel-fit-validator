{
    "name": "bencolmer/laravel-fit-validation",
    "description": "Validate Atlassian Forge Invocation Tokens (FITs) in Laravel",
    "keywords": [
        "laravel",
        "atlassian",
        "forge",
        "FIT"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ben Colmer",
            "email": "ben-colmer@outlook.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "BenColmer\\LaravelFITValidation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "BenColmer\\LaravelFITValidation\\Providers\\LaravelFITValidation"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
